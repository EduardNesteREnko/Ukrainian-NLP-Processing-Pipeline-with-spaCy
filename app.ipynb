   "source": [
    "import spacy\n",
    "\n",
    "nlp = spacy.load(\"uk_core_news_sm\")\n",
    "doc = nlp(\"Супер Український текст.\")\n",
    "print(doc.text)\n",
    "for token in doc:\n",
    "    print(token.text, token.pos_, token.dep_)\n"
   ],
